 ;; MCP servers. Each entry spawns a local subprocess on startup and exposes
 ;; that server's tools, resources, and prompts to the assistant. Writing a
 ;; block opts the server in; :enabled? false keeps it configured but inert —
 ;; connecting spawns a real subprocess and, on first run, may download a
 ;; package over the network.
 ;; :mcp {:connect-timeout-ms 15000                          ; per-server handshake budget (default 15000)
 ;;       :servers {:playwright {:transport :stdio           ; local stdio is the only transport today
 ;;                              :command   "npx"
 ;;                              :args      ["-y" "@playwright/mcp@latest"]
 ;;                              ;; playwright-mcp needs Node 20+, and npx finds
 ;;                              ;; node through PATH — so the server quietly
 ;;                              ;; fails to start if the app is launched from a
 ;;                              ;; shell using an older default (a fresh
 ;;                              ;; terminal, a desktop launcher, a cron job).
 ;;                              ;; Pin it here and it no longer depends on who
 ;;                              ;; started the app:
 ;;                              ;;   :env {"PATH" "/path/to/node20+/bin:/usr/bin:/bin"}
 ;;                              :env       {}
 ;;                              :enabled?  false}
 ;;                 ;; The reference server, which exercises every MCP feature
 ;;                 ;; — tools, resources, and prompts. Useful for checking that
 ;;                 ;; the integration works before pointing it at a real server.
 ;;                 :everything {:transport :stdio
 ;;                              :command   "npx"
 ;;                              :args      ["-y" "@modelcontextprotocol/server-everything"]
 ;;                              :env       {}
 ;;                              :enabled?  false}
 ;;                 ;; GitHub's official server (github/github-mcp-server) is a
 ;;                 ;; Go binary, not a Node package: install it once with
 ;;                 ;; `brew install github-mcp-server` and nothing is fetched
 ;;                 ;; at startup. An absolute path keeps it independent of
 ;;                 ;; PATH (Intel Macs: /usr/local/bin). Note the unscoped npm
 ;;                 ;; package of the same name is unaffiliated with GitHub.
 ;;                 ;;
 ;;                 ;; #env keeps the token out of this file (it reads the real
 ;;                 ;; environment, then the project .env). Unset, it resolves
 ;;                 ;; to nil, the entry fails validation, and the server is
 ;;                 ;; dropped with a warning rather than starting unauthed.
 ;;                 ;; Give the PAT the narrowest scopes you can live with.
 ;;                 ;;
 ;;                 ;; --toolsets narrows what gets advertised, which matters:
 ;;                 ;; every tool schema ships on every LLM call. Omitted, the
 ;;                 ;; server loads context, repos, issues, pull_requests and
 ;;                 ;; users; "all" loads dozens. --read-only drops the writes.
 ;;                 :github {:transport :stdio
 ;;                          :command   "/opt/homebrew/bin/github-mcp-server"
 ;;                          :args      ["stdio" "--toolsets" "repos,issues,pull_requests"]
 ;;                          :env       {"GITHUB_PERSONAL_ACCESS_TOKEN" #env GITHUB_TOKEN}
 ;;                          :enabled?  false}}}
